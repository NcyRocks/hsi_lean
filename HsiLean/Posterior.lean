import Mathlib.Probability.Martingale.Convergence
import Mathlib.Topology.Algebra.InfiniteSum.ENNReal

/-!
# Posteriors over a countable class of measures

Statements: Claude, 2026-11-09, checked by Nathan before the run. Proofs: the agent.

Source: Cohen & Hutter 2020, *Pessimism About Unknown Unknowns Inspires Conservatism*,
Appendix C (`PIBBSS\refs\arxiv\2006.08753\main.tex`, from ~line 880): the posterior-stability
lemma, "Overtaking is Unlikely" (`lem:overtaking`) and "Sum of limits" (`lem:sumoflimits`, ~line 939).

Setting: infinite binary sequences `ℕ → Bool`; a countable class of probability measures `Q i`
with prior weights `w i` summing to one; the true environment is `Q i₀`, with `w i₀ ≠ 0`
(the paper's global assumption that the truth has positive prior weight).
-/

namespace HsiLean.Posterior

open MeasureTheory Filter ENNReal Topology

/-- The first `t` bits of `ω`. -/
def pre (ω : ℕ → Bool) (t : ℕ) : List Bool := List.ofFn fun i : Fin t => ω i

/-- The cylinder of sequences that begin with `x`. -/
def cyl (x : List Bool) : Set (ℕ → Bool) := {ω | pre ω x.length = x}

variable (Q : ℕ → Measure (ℕ → Bool)) (w : ℕ → ℝ≥0∞)

/-- The Bayes mixture on finite strings: `ξ(x) = Σ_i w_i Q_i(x)`. -/
noncomputable def mix (x : List Bool) : ℝ≥0∞ := ∑' i, w i * Q i (cyl x)

/-- The posterior weight of `Q i` after seeing `x`: `w(Q_i | x) = w_i Q_i(x) / ξ(x)`. -/
noncomputable def post (i : ℕ) (x : List Bool) : ℝ≥0∞ := w i * Q i (cyl x) / mix Q w x

/-! ## The Bayes-mixture measure -/

/-- The Bayes mixture as a measure on `ℕ → Bool`: `μ_ξ := Σ_i w_i • Q_i`. -/
noncomputable def mixMeasure : Measure (ℕ → Bool) := Measure.sum (fun i => w i • Q i)

variable [∀ i, IsProbabilityMeasure (Q i)]

/-- Cylinders are determined by finitely many coordinates, so they are measurable. -/
lemma cyl_measurable (x : List Bool) : MeasurableSet (cyl x) := by
  have h : cyl x = ⋂ i : Fin x.length, {ω : ℕ → Bool | ω i.val = x[i.val]} := by
    ext ω
    simp only [cyl, pre, Set.mem_setOf_eq, Set.mem_iInter]
    refine ⟨fun h i => ?_, fun h => ?_⟩
    · have hget : (List.ofFn (fun j : Fin x.length => ω j.val))[i.val]? = x[i.val]? := by
        rw [h]
      simpa [List.getElem?_ofFn, i.isLt] using hget
    · apply List.ext_getElem
      · simp
      · intro j h1 h2
        simp only [List.getElem_ofFn]
        exact h ⟨j, by simpa using h2⟩
  rw [h]
  exact MeasurableSet.iInter fun i =>
    (measurable_pi_apply i.val) (MeasurableSet.singleton _)

/-- The mixture measure evaluated on a cylinder matches `mix`. -/
lemma mixMeasure_cyl (x : List Bool) : mixMeasure Q w (cyl x) = mix Q w x := by
  rw [mixMeasure, Measure.sum_apply _ (cyl_measurable x)]
  rfl

/-- The mixture measure is a probability measure when the prior weights sum to one. -/
lemma isProbabilityMeasure_mixMeasure (hw : ∑' i, w i = 1) :
    IsProbabilityMeasure (mixMeasure Q w) where
  measure_univ := by
    rw [mixMeasure, Measure.sum_apply _ MeasurableSet.univ]
    simp only [Measure.smul_apply, measure_univ, smul_eq_mul, mul_one]
    exact hw

/-- Each weighted summand is dominated by the mixture measure. -/
lemma smul_le_mixMeasure (i : ℕ) : w i • Q i ≤ mixMeasure Q w := by
  exact Measure.le_sum _ i

/-- When `w i ≠ 0` and `w i ≠ ∞`, `Q i` is absolutely continuous w.r.t. the mixture measure. -/
lemma absolutelyContinuous_mixMeasure (i : ℕ) (hwi : w i ≠ 0) (_hwi' : w i ≠ ⊤) :
    Q i ≪ mixMeasure Q w := by
  intro s hs
  have hle : (w i • Q i) s ≤ mixMeasure Q w s := smul_le_mixMeasure Q w i s
  rw [Measure.smul_apply, smul_eq_mul] at hle
  rw [hs, le_zero_iff, mul_eq_zero] at hle
  rcases hle with h | h
  · exact absurd h hwi
  · exact h

/-! ## Natural filtration -/

/-- The σ-algebra generated by the first `t` coordinates: `ℱ t = σ(ω i : i < t)`. -/
noncomputable def preSigma (t : ℕ) : MeasurableSpace (ℕ → Bool) :=
  ⨆ i : Fin t, MeasurableSpace.comap (fun ω : ℕ → Bool => ω i.val) inferInstance

lemma preSigma_mono : Monotone preSigma := by
  intro s t hst
  refine iSup_le fun i => ?_
  exact le_iSup (fun j : Fin t => MeasurableSpace.comap (fun ω : ℕ → Bool => ω j.val) inferInstance)
    ⟨i.val, lt_of_lt_of_le i.isLt hst⟩

lemma preSigma_le (t : ℕ) :
    preSigma t ≤ (inferInstance : MeasurableSpace (ℕ → Bool)) := by
  refine iSup_le fun i => ?_
  exact (measurable_pi_apply i.val).comap_le

/-- The natural filtration on `ℕ → Bool`: at time `t`, we see the first `t` coordinates. -/
noncomputable def filt :
    MeasureTheory.Filtration ℕ (inferInstance : MeasurableSpace (ℕ → Bool)) where
  seq := preSigma
  mono' := preSigma_mono
  le' := preSigma_le

/-- Each coordinate `i < t` is `filt t`-measurable. -/
lemma measurable_coord_of_lt {i t : ℕ} (hi : i < t) :
    Measurable[filt t] (fun ω : ℕ → Bool => ω i) := by
  -- `comap (fun ω => ω i) m ≤ filt t` since `i < t`.
  have h : MeasurableSpace.comap (fun ω : ℕ → Bool => ω i) inferInstance ≤ filt t := by
    show MeasurableSpace.comap (fun ω : ℕ → Bool => ω i) inferInstance ≤ preSigma t
    exact le_iSup
      (fun j : Fin t => MeasurableSpace.comap (fun ω : ℕ → Bool => ω j.val) inferInstance)
      ⟨i, hi⟩
  intro s hs
  exact h _ ⟨s, hs, rfl⟩

/-- Every cylinder `cyl x` with `x.length ≤ t` is `filt t`-measurable. -/
lemma cyl_measurable_filt (x : List Bool) {t : ℕ} (htx : x.length ≤ t) :
    MeasurableSet[filt t] (cyl x) := by
  have h : cyl x = ⋂ i : Fin x.length, {ω : ℕ → Bool | ω i.val = x[i.val]} := by
    ext ω
    simp only [cyl, pre, Set.mem_setOf_eq, Set.mem_iInter]
    refine ⟨fun h i => ?_, fun h => ?_⟩
    · have hget : (List.ofFn (fun j : Fin x.length => ω j.val))[i.val]? = x[i.val]? := by
        rw [h]
      simpa [List.getElem?_ofFn, i.isLt] using hget
    · apply List.ext_getElem
      · simp
      · intro j h1 h2
        simp only [List.getElem_ofFn]
        exact h ⟨j, by simpa using h2⟩
  rw [h]
  refine MeasurableSet.iInter fun i => ?_
  exact (measurable_coord_of_lt (lt_of_lt_of_le i.isLt htx))
    (MeasurableSet.singleton _)

/-! ## Cylinder decomposition and bounds -/

/-- `pre ω (t+1) = pre ω t ++ [ω t]`. -/
lemma pre_succ (ω : ℕ → Bool) (t : ℕ) : pre ω (t + 1) = pre ω t ++ [ω t] := by
  unfold pre
  rw [List.ofFn_succ', List.concat_eq_append]
  congr

/-- A cylinder at length `n` splits into its two length-`n+1` extensions. -/
lemma cyl_eq_union (x : List Bool) :
    cyl x = cyl (x ++ [false]) ∪ cyl (x ++ [true]) := by
  ext ω
  constructor
  · intro h
    simp only [cyl, Set.mem_setOf_eq] at h
    rcases hω : ω x.length with _ | _
    · left
      simp only [cyl, Set.mem_setOf_eq, List.length_append, List.length_singleton]
      rw [pre_succ, h, hω]
    · right
      simp only [cyl, Set.mem_setOf_eq, List.length_append, List.length_singleton]
      rw [pre_succ, h, hω]
  · rintro (h | h) <;>
    · simp only [cyl, Set.mem_setOf_eq, List.length_append, List.length_singleton] at h
      simp only [cyl, Set.mem_setOf_eq]
      rw [pre_succ] at h
      have hlen : (pre ω x.length).length = x.length := by simp [pre]
      exact (List.append_inj h hlen).1

/-- The two length-`n+1` extensions of a cylinder are disjoint. -/
lemma cyl_disjoint (x : List Bool) :
    Disjoint (cyl (x ++ [false])) (cyl (x ++ [true])) := by
  refine Set.disjoint_left.mpr ?_
  intro ω hF hT
  simp only [cyl, Set.mem_setOf_eq, List.length_append, List.length_singleton] at hF hT
  have : x ++ [false] = x ++ [true] := hF.symm.trans hT
  simpa using this

/-- A measure on `ℕ → Bool` decomposes additively on cylinders. -/
lemma measure_cyl_split (μ : Measure (ℕ → Bool)) (x : List Bool) :
    μ (cyl x) = μ (cyl (x ++ [false])) + μ (cyl (x ++ [true])) := by
  rw [cyl_eq_union]
  exact measure_union (cyl_disjoint x) (cyl_measurable _)

/-- The Bayes mixture decomposes on cylinders. -/
lemma mix_split (x : List Bool) :
    mix Q w x = mix Q w (x ++ [false]) + mix Q w (x ++ [true]) := by
  simp only [mix]
  rw [← ENNReal.tsum_add]
  refine tsum_congr fun i => ?_
  rw [← mul_add, ← measure_cyl_split]

/-- Mixture is bounded above by `1` when prior weights sum to one. -/
lemma mix_le_one (hw : ∑' i, w i = 1) (x : List Bool) : mix Q w x ≤ 1 := by
  unfold mix
  calc ∑' i, w i * Q i (cyl x)
      ≤ ∑' i, w i * 1 := ENNReal.tsum_le_tsum fun i => by gcongr; exact prob_le_one
    _ = ∑' i, w i := by simp
    _ = 1 := hw

/-- `post ≤ 1`. -/
lemma post_le_one (hw : ∑' i, w i = 1) (i : ℕ) (x : List Bool) :
    post Q w i x ≤ 1 := by
  have h_num_le : w i * Q i (cyl x) ≤ mix Q w x := ENNReal.le_tsum i
  unfold post
  refine ENNReal.div_le_of_le_mul ?_
  rw [one_mul]
  exact h_num_le

/-- Posteriors sum to one wherever the mixture is positive. -/
theorem tsum_post (hw : ∑' i, w i = 1) (x : List Bool) (hx : mix Q w x ≠ 0) :
    ∑' i, post Q w i x = 1 := by
  have h_mix_le_one : mix Q w x ≤ 1 := mix_le_one Q w hw x
  have h_mix_ne_top : mix Q w x ≠ ⊤ := ne_top_of_le_ne_top one_ne_top h_mix_le_one
  simp only [post, ENNReal.div_eq_inv_mul]
  rw [ENNReal.tsum_mul_left]
  change (mix Q w x)⁻¹ * mix Q w x = 1
  exact ENNReal.inv_mul_cancel hx h_mix_ne_top

/-- Posteriors always sum to at most one. -/
theorem tsum_post_le_one (hw : ∑' i, w i = 1) (x : List Bool) :
    ∑' i, post Q w i x ≤ 1 := by
  by_cases hmix : mix Q w x = 0
  · have hzero : ∀ i, w i * Q i (cyl x) = 0 := ENNReal.tsum_eq_zero.mp hmix
    have hpost_zero : ∀ i, post Q w i x = 0 := by
      intro i
      unfold post
      rw [hzero i]
      simp
    simp [hpost_zero]
  · exact le_of_eq (tsum_post Q w hw x hmix)

/-! ## Martingale convergence setup

Core fact: the posterior sequence is a bounded martingale under the Bayes mixture.
We work via its real-valued image `postR`; the ENNReal version converges by composition
with `ENNReal.ofReal`. -/

/-- Real-valued posterior. -/
noncomputable def postR (i : ℕ) (x : List Bool) : ℝ := (post Q w i x).toReal

/-- `postR` sits in `[0, 1]`. -/
lemma postR_nonneg (i : ℕ) (x : List Bool) : 0 ≤ postR Q w i x :=
  ENNReal.toReal_nonneg

lemma postR_le_one (hw : ∑' i, w i = 1) (i : ℕ) (x : List Bool) :
    postR Q w i x ≤ 1 := by
  have : post Q w i x ≤ 1 := post_le_one Q w hw i x
  unfold postR
  exact ENNReal.toReal_le_of_le_ofReal zero_le_one (by rwa [ENNReal.ofReal_one])

/-- The posterior sequence is strongly adapted to the natural filtration: at time `t`, the
function `postR _ ∘ pre _ t` depends only on the first `t` coordinates. Route: factor through
`Fin t → Bool` (finite ⇒ trivial σ-algebra); each coordinate projection `fun ω => ω i.val`
is `filt t`-measurable for `i < t`. -/
theorem postR_stronglyAdapted (i : ℕ) :
    StronglyAdapted filt (fun t (ω : ℕ → Bool) => postR Q w i (pre ω t)) := by
  intro t
  change StronglyMeasurable[filt t] (fun ω : ℕ → Bool => postR Q w i (pre ω t))
  -- `fun ω => (fun j : Fin t => ω j.val) : (ℕ → Bool) → (Fin t → Bool)` is
  -- `filt t`-measurable since each coordinate projection is.
  have h1 : @Measurable _ _ (filt t) _ (fun ω : ℕ → Bool => fun j : Fin t => ω j.val) := by
    letI : MeasurableSpace (ℕ → Bool) := filt t
    refine measurable_pi_lambda _ ?_
    intro j
    -- show `fun ω => ω j.val` is measurable in the `filt t` σ-algebra
    show @Measurable (ℕ → Bool) Bool (filt t) _ _
    exact measurable_coord_of_lt j.isLt
  -- `Fin t → Bool` is finite, so any function out of it is measurable.
  have h2 : Measurable (fun v : Fin t → Bool => postR Q w i (List.ofFn v)) :=
    measurable_of_countable _
  have heq : (fun ω : ℕ → Bool => postR Q w i (pre ω t)) =
      (fun v : Fin t → Bool => postR Q w i (List.ofFn v)) ∘
        (fun ω : ℕ → Bool => fun j : Fin t => ω j.val) := by
    funext ω
    rfl
  rw [heq]
  exact (h2.comp h1).stronglyMeasurable

/-- `w i ≠ ⊤` whenever the weights sum to one. -/
lemma wi_ne_top (hw : ∑' i, w i = 1) (i : ℕ) : w i ≠ ⊤ := by
  have : w i ≤ 1 := hw ▸ ENNReal.le_tsum i
  exact ne_top_of_le_ne_top one_ne_top this

/-- `post Q w i x` is finite (never `⊤`) when the weights sum to one. -/
lemma post_ne_top (hw : ∑' i, w i = 1) (i : ℕ) (x : List Bool) : post Q w i x ≠ ⊤ :=
  ne_top_of_le_ne_top one_ne_top (post_le_one Q w hw i x)

/-- `mix Q w x` is finite (never `⊤`) when the weights sum to one. -/
lemma mix_ne_top (hw : ∑' i, w i = 1) (x : List Bool) : mix Q w x ≠ ⊤ :=
  ne_top_of_le_ne_top one_ne_top (mix_le_one Q w hw x)

/-- Key algebraic identity: `postR i x · mix(x).toReal = (w i · Q i (cyl x)).toReal`.
Handles both cases `mix(x) = 0` (both sides zero) and `mix(x) > 0` (div-mul-cancel). -/
lemma postR_mul_mix_toReal (hw : ∑' i, w i = 1) (i : ℕ) (x : List Bool) :
    postR Q w i x * (mix Q w x).toReal = (w i * Q i (cyl x)).toReal := by
  have hmix_ne_top : mix Q w x ≠ ⊤ := mix_ne_top Q w hw x
  by_cases hmix : mix Q w x = 0
  · -- Both sides zero: mix = 0 ⇒ w i * Q i (cyl x) ≤ 0, so RHS = 0; LHS has factor 0.
    have hwQ_le : w i * Q i (cyl x) ≤ mix Q w x := ENNReal.le_tsum i
    rw [hmix, le_zero_iff] at hwQ_le
    rw [hwQ_le]
    simp [hmix]
  · -- mix ≠ 0, ≠ ∞: use div_mul_cancel.
    have hpost_mul : post Q w i x * mix Q w x = w i * Q i (cyl x) := by
      unfold post
      exact ENNReal.div_mul_cancel hmix hmix_ne_top
    -- Now toReal both sides.
    have : (post Q w i x * mix Q w x).toReal = (w i * Q i (cyl x)).toReal := by
      rw [hpost_mul]
    rw [ENNReal.toReal_mul] at this
    exact this

/-- `postR Q w i ∘ pre · t` is integrable w.r.t. the Bayes mixture. -/
lemma postR_pre_integrable (hw : ∑' i, w i = 1) (i t : ℕ) :
    Integrable (fun ω => postR Q w i (pre ω t)) (mixMeasure Q w) := by
  haveI : IsProbabilityMeasure (mixMeasure Q w) := isProbabilityMeasure_mixMeasure Q w hw
  have hmeas : AEStronglyMeasurable (fun ω => postR Q w i (pre ω t)) (mixMeasure Q w) :=
    ((postR_stronglyAdapted Q w i t).mono (filt.le t)).aestronglyMeasurable
  refine Integrable.of_mem_Icc 0 1 hmeas.aemeasurable ?_
  exact Filter.Eventually.of_forall fun ω =>
    ⟨postR_nonneg Q w i _, postR_le_one Q w hw i _⟩

/-- Integral of `postR(t) ∘ pre t` over a cylinder `cyl x` with `x.length = t`.
Since `postR(t) ∘ pre t` is constant `postR(t)(x)` on `cyl x`, this is just the
constant times the measure of the cylinder. -/
lemma setIntegral_postR_cyl_of_length_eq (hw : ∑' i, w i = 1) (i t : ℕ) (x : List Bool)
    (hxt : x.length = t) :
    ∫ ω in cyl x, postR Q w i (pre ω t) ∂(mixMeasure Q w) =
      postR Q w i x * (mix Q w x).toReal := by
  have h_eqOn : Set.EqOn (fun ω => postR Q w i (pre ω t))
      (fun _ => postR Q w i x) (cyl x) := by
    intro ω hω
    dsimp only
    simp only [cyl, Set.mem_setOf_eq] at hω
    rw [← hxt, hω]
  rw [setIntegral_congr_fun (cyl_measurable x) h_eqOn, setIntegral_const,
      Measure.real, mixMeasure_cyl, smul_eq_mul, mul_comm]

/-- The one-step martingale identity on a cylinder `cyl x` with `x.length = t`:
the integral over the children splits into the two sub-cylinders, and the algebraic
identity `postR i y · mix(y).toReal = (w i · Q i (cyl y)).toReal` identifies both
sides with `(w i · Q i (cyl x)).toReal`. -/
lemma setIntegral_postR_succ_eq_cyl (hw : ∑' i, w i = 1) (i t : ℕ) (x : List Bool)
    (hxt : x.length = t) :
    ∫ ω in cyl x, postR Q w i (pre ω (t + 1)) ∂(mixMeasure Q w) =
      postR Q w i x * (mix Q w x).toReal := by
  have hxF : (x ++ [false]).length = t + 1 := by simp [hxt]
  have hxT : (x ++ [true]).length = t + 1 := by simp [hxt]
  -- Split cyl x into its two children
  rw [cyl_eq_union x]
  rw [setIntegral_union (cyl_disjoint x) (cyl_measurable _)
    ((postR_pre_integrable Q w hw i (t+1)).integrableOn)
    ((postR_pre_integrable Q w hw i (t+1)).integrableOn)]
  -- compute each sub-integral via the length-eq lemma
  rw [setIntegral_postR_cyl_of_length_eq Q w hw i (t+1) (x ++ [false]) hxF]
  rw [setIntegral_postR_cyl_of_length_eq Q w hw i (t+1) (x ++ [true]) hxT]
  -- postR y · mix(y).toReal = (w i · Q i (cyl y)).toReal for y ∈ {x++[false], x++[true]}
  rw [postR_mul_mix_toReal Q w hw i (x ++ [false])]
  rw [postR_mul_mix_toReal Q w hw i (x ++ [true])]
  rw [postR_mul_mix_toReal Q w hw i x]
  -- The sum of ENNReal factors equals the ENNReal at the parent (via Q_i cyl split)
  rw [← ENNReal.toReal_add, ← mul_add, ← measure_cyl_split (Q i) x]
  · exact ENNReal.mul_ne_top (wi_ne_top w hw i)
      (measure_ne_top (Q i) (cyl (x ++ [false])))
  · exact ENNReal.mul_ne_top (wi_ne_top w hw i)
      (measure_ne_top (Q i) (cyl (x ++ [true])))

/-- The π-system of length-`t` cylinders (indexed by `List Bool` of length `t`). -/
def cyl_pi (t : ℕ) : Set (Set (ℕ → Bool)) := {A | ∃ x : List Bool, x.length = t ∧ A = cyl x}

/-- Length-`t` cylinders form a π-system: they're pairwise disjoint unless equal. -/
lemma isPiSystem_cyl_pi (t : ℕ) : IsPiSystem (cyl_pi t) := by
  rintro A ⟨x, hxlen, rfl⟩ B ⟨y, hylen, rfl⟩ hne
  refine ⟨x, hxlen, ?_⟩
  obtain ⟨ω, hωA, hωB⟩ := hne
  simp only [cyl, Set.mem_setOf_eq] at hωA hωB
  rw [hxlen] at hωA
  rw [hylen] at hωB
  have hxy : x = y := hωA ▸ hωB
  subst hxy
  exact Set.inter_self _

/-- `filt t = generateFrom (length-t cylinders)`. This gives the π-system representation
needed for the Dynkin extension. The `≥` direction is immediate (every cyl of length t is
`filt t`-measurable). The `≤` direction expresses each generator `{ω | ω i = b}` of
`preSigma t` (for `i < t`, `b : Bool`) as a finite union of length-t cyls. -/
lemma filt_eq_generateFrom_cyl_pi (t : ℕ) :
    (filt t : MeasurableSpace (ℕ → Bool)) = MeasurableSpace.generateFrom (cyl_pi t) := by
  refine le_antisymm ?_ ?_
  · -- (≤): preSigma t ≤ generateFrom (cyl_pi t)
    show preSigma t ≤ _
    refine iSup_le fun i => ?_
    -- comap (fun ω => ω i.val) inferInstance ≤ generateFrom (cyl_pi t)
    rintro _ ⟨S, _, rfl⟩
    -- Goal: `(fun ω => ω i.val) ⁻¹' S` is generateFrom (cyl_pi t)-measurable.
    -- Rewrite it as a union over length-t strings v of `cyl (List.ofFn v)`, keeping those with
    -- `v i ∈ S`.
    have h_eq : (fun ω : ℕ → Bool => ω i.val) ⁻¹' S =
        ⋃ v : {v : Fin t → Bool // v i ∈ S}, cyl (List.ofFn v.val) := by
      ext ω
      simp only [Set.mem_preimage, Set.mem_iUnion]
      refine ⟨fun hS => ⟨⟨fun j : Fin t => ω j.val, hS⟩, ?_⟩,
        fun ⟨⟨v, hv⟩, hω⟩ => ?_⟩
      · show pre ω (List.ofFn (fun j : Fin t => ω j.val)).length =
          List.ofFn (fun j : Fin t => ω j.val)
        rw [List.length_ofFn]; rfl
      · simp only [cyl, Set.mem_setOf_eq, List.length_ofFn] at hω
        have hfv : (fun j : Fin t => ω j.val) = v := List.ofFn_inj.mp hω
        have hωi : ω i.val = v i := congrFun hfv i
        rw [hωi]; exact hv
    rw [h_eq]
    refine MeasurableSet.iUnion fun v => ?_
    exact MeasurableSpace.measurableSet_generateFrom
      ⟨List.ofFn v.val, List.length_ofFn, rfl⟩
  · -- (≥): generateFrom (cyl_pi t) ≤ filt t
    refine MeasurableSpace.generateFrom_le fun A ⟨x, hxlen, hA⟩ => ?_
    subst hA
    exact cyl_measurable_filt x (le_of_eq hxlen)

/-- One-step martingale identity on a filt-`t`-measurable set (Dynkin extension of the
cylinder identity). Uses `MeasurableSpace.induction_on_inter` with π-system of length-`t`
cylinders. The identity is preserved under complement (via `setIntegral_compl` and total
integral equality) and countable disjoint union (via `integral_iUnion`). -/
lemma setIntegral_postR_succ_eq (hw : ∑' i, w i = 1) (i t : ℕ)
    {A : Set (ℕ → Bool)} (hA : MeasurableSet[filt t] A) :
    ∫ ω in A, postR Q w i (pre ω (t + 1)) ∂(mixMeasure Q w) =
      ∫ ω in A, postR Q w i (pre ω t) ∂(mixMeasure Q w) := by
  haveI : IsProbabilityMeasure (mixMeasure Q w) := isProbabilityMeasure_mixMeasure Q w hw
  set f : (ℕ → Bool) → ℝ := fun ω => postR Q w i (pre ω (t + 1))
  set g : (ℕ → Bool) → ℝ := fun ω => postR Q w i (pre ω t)
  have hf_int : Integrable f (mixMeasure Q w) := postR_pre_integrable Q w hw i (t+1)
  have hg_int : Integrable g (mixMeasure Q w) := postR_pre_integrable Q w hw i t
  -- Total integral equality: both ∫ f = ∫ g. Proved by splitting univ into length-t cyls.
  have h_total : ∫ ω, f ω ∂(mixMeasure Q w) = ∫ ω, g ω ∂(mixMeasure Q w) := by
    have h_univ : (Set.univ : Set (ℕ → Bool)) = ⋃ v : Fin t → Bool, cyl (List.ofFn v) := by
      ext ω
      refine ⟨fun _ => Set.mem_iUnion.mpr ⟨fun j => ω j.val, ?_⟩, fun _ => trivial⟩
      show pre ω (List.ofFn (fun j : Fin t => ω j.val)).length =
        List.ofFn (fun j : Fin t => ω j.val)
      rw [List.length_ofFn]; rfl
    have h_disj : Pairwise fun v u : Fin t → Bool =>
        Disjoint (cyl (List.ofFn v)) (cyl (List.ofFn u)) := by
      intro v u hvu
      refine Set.disjoint_left.mpr fun ω hωv hωu => ?_
      simp only [cyl, Set.mem_setOf_eq, List.length_ofFn] at hωv hωu
      apply hvu
      exact List.ofFn_inj.mp (hωv.symm.trans hωu)
    have hm : ∀ v : Fin t → Bool, MeasurableSet (cyl (List.ofFn v)) :=
      fun v => cyl_measurable _
    rw [← setIntegral_univ (μ := mixMeasure Q w) (f := f),
        ← setIntegral_univ (μ := mixMeasure Q w) (f := g), h_univ,
        integral_iUnion_fintype hm h_disj (fun _ => hf_int.integrableOn),
        integral_iUnion_fintype hm h_disj (fun _ => hg_int.integrableOn)]
    apply Finset.sum_congr rfl
    intro v _
    rw [show f = fun ω => postR Q w i (pre ω (t+1)) from rfl,
        show g = fun ω => postR Q w i (pre ω t) from rfl,
        setIntegral_postR_succ_eq_cyl Q w hw i t (List.ofFn v) (List.length_ofFn),
        setIntegral_postR_cyl_of_length_eq Q w hw i t (List.ofFn v) (List.length_ofFn)]
  -- Translate hA from filt t to generateFrom cyl_pi, then apply induction_on_inter.
  rw [filt_eq_generateFrom_cyl_pi] at hA
  induction A, hA using MeasurableSpace.induction_on_inter rfl (isPiSystem_cyl_pi t) with
  | empty => simp
  | basic A hA =>
    obtain ⟨x, hxlen, rfl⟩ := hA
    rw [setIntegral_postR_succ_eq_cyl Q w hw i t x hxlen,
      setIntegral_postR_cyl_of_length_eq Q w hw i t x hxlen]
  | compl A hAm ih =>
    have hAm' : MeasurableSet A := by
      have hle : filt t ≤ (inferInstance : MeasurableSpace (ℕ → Bool)) := filt.le t
      rw [filt_eq_generateFrom_cyl_pi] at hle
      exact hle _ hAm
    rw [setIntegral_compl hAm' hf_int, setIntegral_compl hAm' hg_int, ih, h_total]
  | iUnion s hd hm ih =>
    have hm' : ∀ n, MeasurableSet (s n) := fun n => by
      have hle : filt t ≤ (inferInstance : MeasurableSpace (ℕ → Bool)) := filt.le t
      rw [filt_eq_generateFrom_cyl_pi] at hle
      exact hle _ (hm n)
    rw [integral_iUnion hm' hd hf_int.integrableOn,
        integral_iUnion hm' hd hg_int.integrableOn]
    exact tsum_congr ih

/-- **One-step martingale property** (Cohen–Hutter, lem:poststable, lines 903–913):
`E[postR(t+1) ∘ pre(t+1) | filt t] =ᵐ postR(t) ∘ pre t`. Uses `ae_eq_condExp_of_forall_setIntegral_eq`
with the setIntegral identity reduced via the Dynkin argument above. -/
theorem postR_condExp_succ (hw : ∑' i, w i = 1) (i t : ℕ) :
    (mixMeasure Q w)[fun ω => postR Q w i (pre ω (t + 1)) | filt t] =ᵐ[mixMeasure Q w]
      fun ω => postR Q w i (pre ω t) := by
  haveI : IsProbabilityMeasure (mixMeasure Q w) := isProbabilityMeasure_mixMeasure Q w hw
  haveI : SigmaFinite ((mixMeasure Q w).trim (filt.le t)) := inferInstance
  set f : (ℕ → Bool) → ℝ := fun ω => postR Q w i (pre ω (t + 1)) with hf_def
  set g : (ℕ → Bool) → ℝ := fun ω => postR Q w i (pre ω t) with hg_def
  have hf_int : Integrable f (mixMeasure Q w) := postR_pre_integrable Q w hw i (t+1)
  have hg_int : Integrable g (mixMeasure Q w) := postR_pre_integrable Q w hw i t
  have hg_sm : AEStronglyMeasurable[filt t] g (mixMeasure Q w) :=
    (postR_stronglyAdapted Q w i t).aestronglyMeasurable
  have h_eq : ∀ A : Set (ℕ → Bool), MeasurableSet[filt t] A →
      (mixMeasure Q w) A < ∞ → ∫ x in A, g x ∂(mixMeasure Q w) =
        ∫ x in A, f x ∂(mixMeasure Q w) :=
    fun A hA _ => (setIntegral_postR_succ_eq Q w hw i t hA).symm
  have h := ae_eq_condExp_of_forall_setIntegral_eq (filt.le t) hf_int
    (fun A _ _ => hg_int.integrableOn) h_eq hg_sm
  exact h.symm

/-- The martingale identity on cylinders, which is the paper's calculation
(Cohen–Hutter lem:poststable, lines 903–913). On any cyl x of length t (an atom of filt t),
∫ post(t+1) dμ = w_i · Q_i(cyl x) = ∫ post(t) dμ, using `mix_split` and the definition of post.
The general case `s ≤ t` reduces to the one-step via tower. -/
theorem postR_condExp (hw : ∑' i, w i = 1) (i : ℕ) :
    ∀ s t, s ≤ t → (mixMeasure Q w)[fun ω => postR Q w i (pre ω t) | filt s] =ᵐ[mixMeasure Q w]
      fun ω => postR Q w i (pre ω s) := by
  haveI : IsProbabilityMeasure (mixMeasure Q w) := isProbabilityMeasure_mixMeasure Q w hw
  intro s t hst
  induction t, hst using Nat.le_induction with
  | base =>
    -- s = t: condExp of a filt s-measurable function is itself.
    have h := condExp_of_stronglyMeasurable (filt.le s) (postR_stronglyAdapted Q w i s)
      (postR_pre_integrable Q w hw i s)
    exact h.eventuallyEq
  | succ t hst ih =>
    have h_tower := condExp_condExp_of_le (μ := mixMeasure Q w)
      (f := fun ω => postR Q w i (pre ω (t+1))) (filt.mono hst) (filt.le t)
    have h_onestep := postR_condExp_succ Q w hw i t
    have h_push := condExp_congr_ae (m := filt s) (μ := mixMeasure Q w) h_onestep
    exact h_tower.symm.trans (h_push.trans ih)

/-- **Martingale property** (Cohen–Hutter, lem:poststable):
`(fun ω t => postR Q w i (pre ω t))` is a martingale under `mixMeasure Q w`.
Combines strong adaptedness and the cylinder-level condExp identity. -/
theorem postR_martingale (hw : ∑' i, w i = 1) (i : ℕ) :
    MeasureTheory.Martingale (fun t ω => postR Q w i (pre ω t)) filt (mixMeasure Q w) :=
  ⟨postR_stronglyAdapted Q w i, postR_condExp Q w hw i⟩

/-- `ENNReal.ofReal` lifts real convergence to `ℝ≥0∞` convergence. -/
lemma tendsto_ofReal_of_tendsto {f : ℕ → ℝ} {L : ℝ}
    (h : Tendsto f atTop (𝓝 L)) :
    Tendsto (fun n => ENNReal.ofReal (f n)) atTop (𝓝 (ENNReal.ofReal L)) :=
  (ENNReal.continuous_ofReal.tendsto L).comp h

/-- Mix-a.s. convergence of the ENNReal posterior. -/
theorem post_converges_mix (hw : ∑' i, w i = 1) (i : ℕ) :
    ∀ᵐ ω ∂(mixMeasure Q w), ∃ L, Tendsto (fun t => post Q w i (pre ω t)) atTop (𝓝 L) := by
  haveI : IsProbabilityMeasure (mixMeasure Q w) := isProbabilityMeasure_mixMeasure Q w hw
  -- Real-valued convergence from the martingale theorem.
  have hmart : MeasureTheory.Martingale (fun t ω => postR Q w i (pre ω t)) filt (mixMeasure Q w) :=
    postR_martingale Q w hw i
  -- L¹ bound: `postR ≤ 1` on probability space.
  have hbdd : ∀ t, eLpNorm (fun ω => postR Q w i (pre ω t)) 1 (mixMeasure Q w) ≤ 1 := by
    intro t
    refine (eLpNorm_le_of_ae_bound (C := 1) ?_).trans ?_
    · refine Filter.Eventually.of_forall fun ω => ?_
      rw [Real.norm_eq_abs, abs_of_nonneg (postR_nonneg Q w i _)]
      exact postR_le_one Q w hw i _
    · simp
  -- Apply Mathlib's a.e. convergence theorem on the submartingale.
  have hconv := hmart.submartingale.ae_tendsto_limitProcess hbdd
  -- Lift from `ℝ` convergence to `ℝ≥0∞` convergence via `ENNReal.ofReal`.
  filter_upwards [hconv] with ω hω
  refine ⟨ENNReal.ofReal (filt.limitProcess (fun t ω => postR Q w i (pre ω t))
            (mixMeasure Q w) ω), ?_⟩
  -- `post = ENNReal.ofReal postR` since `post ≤ 1 ≠ ⊤`.
  have hpost_eq : ∀ t, post Q w i (pre ω t) =
      ENNReal.ofReal (postR Q w i (pre ω t)) := by
    intro t
    unfold postR
    rw [ENNReal.ofReal_toReal]
    exact ne_top_of_le_ne_top one_ne_top (post_le_one Q w hw i _)
  simp_rw [hpost_eq]
  exact tendsto_ofReal_of_tendsto hω

/-- **Overtaking is unlikely** (Cohen–Hutter `lem:overtaking`, from Hutter 2009 Lemma 4):
`P[R(x_{<t}) / P(x_{<t}) ≥ c infinitely often] ≤ 1/c`, written without division. -/
theorem overtaking (P R : Measure (ℕ → Bool)) [IsProbabilityMeasure P]
    [IsProbabilityMeasure R] (c : ℝ≥0∞) (hc : c ≠ 0) :
    P {ω | ∃ᶠ t in atTop, c * P (cyl (pre ω t)) ≤ R (cyl (pre ω t))} ≤ c⁻¹ := by
  sorry

/-- **Posteriors converge** (Cohen–Hutter's posterior-stability lemma, from Hutter 2016
Thm 4): each posterior weight converges with probability one under the true measure. -/
theorem post_converges (hw : ∑' i, w i = 1) (i₀ : ℕ) (hi₀ : w i₀ ≠ 0) (i : ℕ) :
    ∀ᵐ ω ∂(Q i₀), ∃ L, Tendsto (fun t => post Q w i (pre ω t)) atTop (𝓝 L) := by
  have hwi_ne_top : w i₀ ≠ ⊤ := by
    have : w i₀ ≤ 1 := hw ▸ ENNReal.le_tsum i₀
    exact ne_top_of_le_ne_top one_ne_top this
  exact absolutelyContinuous_mixMeasure Q w i₀ hi₀ hwi_ne_top (post_converges_mix Q w hw i)

/-- Combining `post_converges` over the countable class: every posterior converges a.s. -/
theorem post_converges_all (hw : ∑' i, w i = 1) (i₀ : ℕ) (hi₀ : w i₀ ≠ 0) :
    ∀ᵐ ω ∂(Q i₀),
      ∀ i, ∃ L, Tendsto (fun t => post Q w i (pre ω t)) atTop (𝓝 L) := by
  rw [ae_all_iff]
  exact fun i => post_converges Q w hw i₀ hi₀ i

/-- Any convergent-pointwise sum of limits is bounded by 1 — the Fatou direction. -/
lemma tsum_limit_le_one {L : ℕ → ℝ≥0∞} {f : ℕ → ℕ → ℝ≥0∞}
    (h_conv : ∀ i, Tendsto (fun t => f t i) atTop (𝓝 (L i)))
    (h_bdd : ∀ t, ∑' i, f t i ≤ 1) : ∑' i, L i ≤ 1 := by
  rw [ENNReal.tsum_eq_iSup_sum]
  refine iSup_le fun F => ?_
  have hfinite_lim : Tendsto (fun t => ∑ i ∈ F, f t i) atTop (𝓝 (∑ i ∈ F, L i)) :=
    tendsto_finsetSum F fun i _ => h_conv i
  have hfinite_le : ∀ t, ∑ i ∈ F, f t i ≤ 1 := fun t =>
    (ENNReal.sum_le_tsum F).trans (h_bdd t)
  exact le_of_tendsto' hfinite_lim hfinite_le

/-- **Sum of limits** (Cohen–Hutter `lem:sumoflimits`): with probability one under the true
measure, every posterior converges and the limits still sum to one — no posterior mass
escapes to infinity. -/
theorem sum_of_limits (hw : ∑' i, w i = 1) (i₀ : ℕ) (hi₀ : w i₀ ≠ 0) :
    ∀ᵐ ω ∂(Q i₀), ∃ L : ℕ → ℝ≥0∞,
      (∀ i, Tendsto (fun t => post Q w i (pre ω t)) atTop (𝓝 (L i))) ∧ ∑' i, L i = 1 := by
  filter_upwards [post_converges_all Q w hw i₀ hi₀] with ω h
  classical
  refine ⟨fun i => (h i).choose, fun i => (h i).choose_spec, ?_⟩
  -- ≤ 1 direction: Fatou on the uniform bound `tsum_post ≤ 1`.
  have h_le : ∑' i, (h i).choose ≤ 1 :=
    tsum_limit_le_one (fun i => (h i).choose_spec)
      (fun t => tsum_post_le_one Q w hw _)
  refine le_antisymm h_le ?_
  -- ≥ 1 direction: the paper's finite-subclass argument using `overtaking`.
  sorry

end HsiLean.Posterior
